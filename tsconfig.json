{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "tmp/phase09-next-dist/types/**/*.ts",
    "tmp/phase09-next-dist/dev/types/**/*.ts",
    "tmp/phase09-loading-next/types/**/*.ts",
    "tmp/phase09-loading-next/dev/types/**/*.ts",
    "tmp/phase10-enrollment-next/types/**/*.ts",
    "tmp/phase10-enrollment-next/dev/types/**/*.ts",
    "tmp/phase10-enrollment-next2/types/**/*.ts",
    "tmp/phase10-enrollment-next2/dev/types/**/*.ts",
    "tmp/phase10-enrollment-next3/types/**/*.ts",
    "tmp/phase10-enrollment-next3/dev/types/**/*.ts",
    "tmp/phase10-enrollment-final/types/**/*.ts",
    "tmp/phase10-enrollment-final/dev/types/**/*.ts",
    "tmp/phase10-review-next/types/**/*.ts",
    "tmp/phase10-review-next/dev/types/**/*.ts",
    "tmp/phase10-local-next/types/**/*.ts",
    "tmp/phase10-local-next/dev/types/**/*.ts",
    "tmp/phase10-authenticated-next/types/**/*.ts",
    "tmp/phase10-authenticated-next/dev/types/**/*.ts",
    "tmp/learning-flow-next/types/**/*.ts",
    "tmp/learning-flow-next/dev/types/**/*.ts",
    "tmp/placement-qa-next/types/**/*.ts",
    "tmp/placement-qa-next/dev/types/**/*.ts",
    "tmp/placement-build-next/types/**/*.ts",
    "tmp/placement-build-next/dev/types/**/*.ts",
    "tmp/admin-analytics-next/types/**/*.ts",
    "tmp/admin-analytics-next/dev/types/**/*.ts",
    "tmp/cart-local-next/types/**/*.ts",
    "tmp/cart-local-next/dev/types/**/*.ts",
    "tmp/content-qa-next/types/**/*.ts",
    "tmp/content-qa-next/dev/types/**/*.ts",
    "tmp/content-qa-next2/types/**/*.ts",
    "tmp/content-qa-next2/dev/types/**/*.ts",
    "tmp/.next-perf/types/**/*.ts",
    "tmp/.next-perf/dev/types/**/*.ts",
    ".next-qa/types/**/*.ts",
    ".next-qa/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
