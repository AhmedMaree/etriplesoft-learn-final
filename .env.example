NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DEV_PROJECT_REF=
AUTH_SITE_URL=http://127.0.0.1:3010
MUX_ENVIRONMENT=development
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=
MUX_ALLOWED_ORIGINS=http://127.0.0.1:3010
# Bunny Stream (server-only). The token key is the library's embed view token authentication key.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Hosted checkout remains disabled until a Kashier sandbox account is configured.
KASHIER_CHECKOUT_ENABLED=false
# test (sandbox keys, test-api.kashier.io) or live (live keys, api.kashier.io; needs a public HTTPS AUTH_SITE_URL and a live webhook).
KASHIER_MODE=test
KASHIER_MERCHANT_ID=
KASHIER_PAYMENT_API_KEY=
# Next.js expands $VARIABLE references in .env files. Escape literal dollars
# in credentials as \$ (including inside quotes); use raw values in host dashboards.
KASHIER_SECRET_KEY=
# Optional in test mode: leave empty for localhost and use Check payment status
# after returning from Kashier. Required public HTTPS endpoint in live mode.
KASHIER_WEBHOOK_URL=
# Optional machine-local SWC cache: use a dedicated trusted user directory only if needed.
SWC_NATIVE_BINDING_CACHE=
# Demo-only learner pages (AI assistant, community, messages, calendar). Keep false for real users.
NEXT_PUBLIC_SHOW_DEMO_FEATURES=false

# AI learning assistant (server-only). Get a key at https://aistudio.google.com/apikey.
# Without it the assistant page shows an unavailable state; saved history still loads.
GEMINI_API_KEY=
# Optional extra keys, tried in order when a key hits a quota or is rejected (up to GEMINI_API_KEY_9).
# Quotas are per Google project and model: only keys from different projects add capacity.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# Optional model overrides. Defaults: chat replies, opt-in Deep thinking (falls back to the chat
# model when the key has no quota for it; free-tier keys have none), conversation titles.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_DEEP_MODEL=gemini-4-argon
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# Course chat (RAG) embeddings, 768 dimensions. Changing it requires rebuilding every course index.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional: model for npm run ai:transcribe (defaults to GEMINI_LIGHT_MODEL).
GEMINI_TRANSCRIBE_MODEL=

# Operator scripts (course/video import, AI indexing) sign in as an administrator. Admin RPCs need an
# MFA-verified session: set up the authenticator in the admin area once, then store the base32 key
# shown under "Can't scan it?" here. Local machine only; never commit real values.
UPLOAD_ADMIN_EMAIL=
UPLOAD_ADMIN_PASSWORD=
UPLOAD_ADMIN_TOTP_SECRET=

# Local development only (npm run dev): true skips the admin MFA screen. Ignored by builds. The DEV
# database has its own switch: learning_private.admin_security.mfa_required (default true).
ADMIN_MFA_DISABLED=

# Transactional email through Resend (server-only; never NEXT_PUBLIC_*). Optional: without these, organization
# invitations are shared by copying their links and no assignment emails are sent.
# EMAIL_FROM must use a domain verified in Resend, e.g. "ETripleSoft Learn <learn@mail.etriplesoft.com>".
# Account emails (sign-up confirmation, password reset) go through Supabase Auth: in the Supabase dashboard set
# custom SMTP to host smtp.resend.com, port 465, user "resend", password = the same API key.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
